// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  todos     Todo[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.UpdatedAtString
}

model Todo {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.UpdatedAtString
}
